# AuthentiHire - Environment Configuration Example
# Copy this file to .env and replace placeholder values with environment-specific configuration.

# ==============================================================================
# Environment & Deployment Mode
# ==============================================================================
# Options: development, staging, production
ENVIRONMENT=development

# ==============================================================================
# Database Configuration
# ==============================================================================
# SQLite default: sqlite:///data/authentihire.db
# PostgreSQL example: postgresql://user:password@localhost:5432/authentihire
DATABASE_URL=sqlite:///data/authentihire.db

# Database Connection Pool Settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Optional Redis connection for distributed rate limiting across multiple workers
# REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Authentication & Security Secrets
# ==============================================================================
# Cryptographic secret key used for signing JWT access tokens (HS256).
# IMPORTANT: Generate a high-entropy 256-bit random string for production.
# Example command to generate: openssl rand -hex 32
AUTH_SECRET_KEY=authentihire-dev-secret-key-do-not-use-in-production-change-me

# Access token lifetime in minutes (default: 1440 mins = 24 hours)
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cookie Security Flags
# Set to 'true' in production behind HTTPS to enforce Secure attribute on cookies
COOKIE_SECURE=false

# HTTP Strict Transport Security (HSTS)
# Set to 'true' in HTTPS production environments
ENABLE_HSTS=false

# Rate Limiting Controls
RATE_LIMIT_ANALYZE_MAX_REQUESTS=60

# SSRF & Website Inspection Controls
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=100000

# ==============================================================================
# API Server Configuration
# ==============================================================================
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (never use wildcard '*' with credentials enabled)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
